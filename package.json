{
  "name": "youtube-llm-summarizer",
  "version": "1.0.0",
  "description": "Obsidian plugin that summarizes YouTube captions into study notes with an LLM",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "youtube",
    "summarizer",
    "ai",
    "note"
  ],
  "author": "teinam",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "obsidian": "^1.14.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1169.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1169.0",
    "@aws-sdk/credential-provider-ini": "^3.973.30"
  }
}
