{
  "name": "youtube-llm-summarizer",
  "version": "1.0.0",
  "description": "Obsidian plugin that summarizes YouTube captions into study notes with an LLM",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "youtube",
    "summarizer",
    "ai",
    "note"
  ],
  "author": "teinam",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.20.0",
    "fast-check": "^3.15.0",
    "jsdom": "^28.1.0",
    "obsidian": "^1.5.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1168.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1168.0",
    "@aws-sdk/credential-provider-ini": "^3.973.30"
  }
}
